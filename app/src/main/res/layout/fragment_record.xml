<?xml version="1.0" encoding="utf-8"?>
<!-- 记录页：全部记录按时间倒序；行末删除，顶部清空，debug 构建多一个造数入口。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_paper">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_arcade_wash" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_arcade_pill"
                android:clickable="true"
                android:contentDescription="@string/common_back"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="←"
                android:textColor="@color/arcade_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/record_title"
                android:textColor="@color/arcade_ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_arcade_pill"
                android:clickable="true"
                android:contentDescription="@string/record_clear"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/record_clear"
                android:textColor="@color/arcade_orange"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/record_hint"
            android:textColor="@color/arcade_ink_soft"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <!-- 与排行榜同一套 ListView 复用；记录页多一个“清空”和 debug 造数入口。 -->
            <ListView
                android:id="@+id/listRecords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:overScrollMode="never"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_arcade_card"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="22dp"
                    android:text="@string/record_empty"
                    android:textColor="@color/arcade_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/record_empty_hint"
                    android:textColor="@color/arcade_ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/arcade_ink_soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSeed"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_arcade_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/record_seed"
                android:textColor="@color/arcade_ink_soft"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
