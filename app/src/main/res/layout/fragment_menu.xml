<?xml version="1.0" encoding="utf-8"?>
<!--
  主菜单（docs/12-UI设计方案.md §3.1）
  层次：背景图 → 压暗层 → 可滚动内容。
  为什么外面套 ScrollView：320dp 宽的小屏上三档难度 + 开关 + 双按钮会超出可视高度，
  固定布局会被裁掉；ScrollView 只在小屏生效，设计稿比例靠 fillViewport + 权重保持。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_vertical" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/menu_title"
                android:textColor="@color/text"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="0.28"
                android:text="@string/menu_subtitle"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/menu_player_label"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/inputPlayerName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:hint="@string/menu_player_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="12"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_disabled"
                android:textSize="16sp"
                android:autofillHints=""
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp"
                android:text="@string/menu_difficulty_label"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimple"
                    style="@style/Widget.AircraftWar.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/menu_difficulty_simple" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNormal"
                    style="@style/Widget.AircraftWar.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:text="@string/menu_difficulty_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHard"
                    style="@style/Widget.AircraftWar.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/menu_difficulty_hard" />
            </LinearLayout>

            <TextView
                android:id="@+id/textDifficultyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp"
                android:text="@string/menu_difficulty_desc_normal"
                android:textColor="@color/text_disabled"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_music"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/menu_music_desc"
                        android:textColor="@color/text_disabled"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:checked="true" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/Widget.AircraftWar.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:text="@string/menu_start" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecords"
                    style="@style/Widget.AircraftWar.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/menu_records"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRanking"
                    style="@style/Widget.AircraftWar.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/menu_ranking"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/menu_footer"
                android:textColor="@color/text_disabled"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
