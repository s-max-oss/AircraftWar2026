<?xml version="1.0" encoding="utf-8"?>
<!-- UI 专项标题屏：背景与飞机沿用游戏素材；ScrollView 保证窄屏和输入法下可达。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_ink">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_arcade_wash" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputPlayerName"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_arcade_pill"
                    android:hint="@string/menu_player_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLength="12"
                    android:maxLines="1"
                    android:paddingHorizontal="17dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/arcade_ink"
                    android:textColorHint="@color/arcade_ink_soft"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/switchMusic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_arcade_pill"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_music" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="@color/arcade_ink"
                android:shadowDx="3"
                android:shadowDy="5"
                android:shadowRadius="2"
                android:text="@string/menu_title"
                android:textColor="@color/arcade_yellow"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@color/arcade_ink"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:paddingHorizontal="14dp"
                android:text="@string/menu_subtitle"
                android:textColor="@color/arcade_paper_light"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="160dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="-12"
                    android:src="@drawable/elite" />

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="12"
                    android:src="@drawable/mob" />

                <ImageView
                    android:layout_width="260dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/hero" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="@string/menu_difficulty_hint"
                android:textColor="@color/arcade_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSimple"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arcade_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/menu_difficulty_simple"
                    android:textColor="@color/arcade_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNormal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arcade_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/menu_difficulty_normal"
                    android:textColor="@color/arcade_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arcade_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/menu_difficulty_hard"
                    android:textColor="@color/arcade_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textDifficultyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/arcade_ink_soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_arcade_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/menu_start"
                android:textColor="@color/arcade_ink"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- S3：记录/排行榜入口，沿用 v5 胶囊样式，不重画四页。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRanking"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arcade_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/menu_ranking"
                    android:textColor="@color/arcade_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecords"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arcade_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/menu_records"
                    android:textColor="@color/arcade_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/menu_footer"
                android:textColor="@color/arcade_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
