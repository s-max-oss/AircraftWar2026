<?xml version="1.0" encoding="utf-8"?>
<!-- 排行榜/记录页的单行。根布局不设 clickable，删除按钮独立响应，避免整行抢焦点。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_arcade_row"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/textRank"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_arcade_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/arcade_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/arcade_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/arcade_ink_soft"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/textMetaSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/arcade_ink_soft"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/arcade_orange"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="×"
        android:textColor="@color/arcade_ink_soft"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
