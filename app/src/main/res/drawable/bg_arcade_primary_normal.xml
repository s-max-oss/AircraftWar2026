<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arcade_ink" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFE59A"
                android:centerColor="@color/arcade_yellow" android:endColor="@color/arcade_orange" />
            <stroke android:width="3dp" android:color="@color/arcade_ink" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
